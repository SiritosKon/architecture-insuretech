        <mxCell id="client_p" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;verticalAlign=middle;align=center;" value="Частный клиент&#xa;[Person]" vertex="1">
          <mxGeometry height="100" width="180" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="web" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="Веб-приложение&lt;br&gt;Подбор/оформление, форма заявки ОСАГО,&lt;br&gt;отображение предложений в реальном времени" vertex="1">
          <mxGeometry height="120" width="220" x="330" y="300" as="geometry" />
        </mxCell>
        <mxCell id="core" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="core-app&lt;br&gt;Оформление страховок и ОСАГО.&lt;br&gt;REST + WebSocket для веб-приложения.&lt;br&gt;Оркестрация заявок ОСАГО, стрим предложений клиенту.&lt;br&gt;Локальная реплика продуктов/тарифов (обновляется событиями).&lt;br&gt;Публикует insurance.issued (Transactional Outbox).&lt;br&gt;Вызов osago-aggregator: Timeout, Retry, Circuit Breaker." vertex="1">
          <mxGeometry height="195" width="300" x="640" y="140" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="client-info&lt;br&gt;Клиентские данные (личный кабинет, данные при оформлении)" vertex="1">
          <mxGeometry height="110" width="300" x="330" y="585" as="geometry" />
        </mxCell>
        <mxCell id="pg" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="PostgreSQL&lt;br&gt;&lt;br&gt;Отдельная схема на сервис" vertex="1">
          <mxGeometry height="140" width="300" x="543" y="880" as="geometry" />
        </mxCell>
        <mxCell id="agg" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="ins-product-aggregator&lt;br&gt;&lt;br&gt;Фоновый опрос страховых, агрегация продуктов.&lt;br&gt;Публикует изменения событиями.&lt;br&gt;Отказоустойчивость к страховым: Retry, Timeout, Circuit Breaker." vertex="1">
          <mxGeometry height="140" width="300" x="1359" y="85" as="geometry" />
        </mxCell>
        <mxCell id="kafka" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;fontStyle=1;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="Kafka&lt;br&gt;&lt;br&gt;Топики: product-catalog.updated, insurance.issued,&lt;br&gt;osago.offer.received" vertex="1">
          <mxGeometry height="170" width="300" x="1010" y="360" as="geometry" />
        </mxCell>
        <mxCell id="osago" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;fontStyle=1;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="osago-aggregator&lt;br&gt;&lt;br&gt;Отправка заявок ОСАГО в страховые,&lt;br&gt;опрос решений (poll ≤ 60 c), стрим предложений.&lt;br&gt;Stateless-обработка, состояние — в своём хранилище.&lt;br&gt;Отказоустойчивость к страховым: Timeout ≤60с, Retry (backoff), Circuit Breaker, Rate Limiting." vertex="1">
          <mxGeometry height="185" width="300" x="1010" y="619" as="geometry" />
        </mxCell>
        <mxCell id="settle" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="ins-comp-settlement&lt;br&gt;&lt;br&gt;Взаиморасчёты; реестр — из событий insurance.issued;&lt;br&gt;реплика продуктов — из событий." vertex="1">
          <mxGeometry height="140" width="300" x="1010" y="880" as="geometry" />
        </mxCell>
        <mxCell id="osago_db" parent="1" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=11;verticalAlign=middle;align=center;imageAlign=left;imageVerticalAlign=middle;imageWidth=34;imageHeight=34;spacingLeft=42;align=left;spacingLeft=40;image=data:image/svg+xml,;" value="osago-db&lt;br&gt;&lt;br&gt;Состояние заявок и предложений ОСАГО" vertex="1">
          <mxGeometry height="140" width="180" x="1499" y="877" as="geometry" />
        </mxCell>
        <mxCell id="ins" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;strokeColor=#5D5666;fontSize=11;verticalAlign=middle;align=center;" value="Страховые компании&lt;br&gt;&lt;br&gt;5 → 10 партнёров&lt;br&gt;• REST API продуктов&lt;br&gt;• REST API ОСАГО: создать заявку / получить предложение" vertex="1">
          <mxGeometry height="400" width="250" x="1453" y="267" as="geometry" />
        </mxCell>
        <mxCell id="n_store" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;size=14;fontSize=11;" value="&lt;b&gt;osago-aggregator — своё хранилище: ДА&lt;/b&gt;&lt;br&gt;Опрос страховых асинхронный (poll ≤60с), сервис в нескольких репликах → состояние заявок/предложений нельзя держать в памяти. Идемпотентность и дедуп по applicationId, восстановление опроса при рестарте/переезде на другую реплику." vertex="1">
          <mxGeometry height="190" width="236" x="30" y="795" as="geometry" />
        </mxCell>
        <mxCell id="n_api" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;size=14;fontSize=11;" value="&lt;b&gt;Интеграция core-app ↔ osago-aggregator&lt;/b&gt;&lt;br&gt;• Команда &#39;создать заявку&#39; — REST (синхронно возвращает applicationId).&lt;br&gt;• Предложения — события osago.offer.received через Kafka (стрим по мере прихода от страховых).&lt;br&gt;Разделение command (REST) и потока (events)." vertex="1">
          <mxGeometry height="175" width="236" x="30" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n_web" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;size=14;fontSize=11;" value="&lt;b&gt;Интеграция веб ↔ core-app&lt;/b&gt;&lt;br&gt;• Подача заявки — REST.&lt;br&gt;• Предложения по мере прихода — WebSocket (стрим, новая стрелка). REST request/response не даёт стриминга." vertex="1">
          <mxGeometry height="150" width="236" x="30" y="430" as="geometry" />
        </mxCell>
